<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tasbeehRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Beads & Counter (Strictly Left Side) -->
    <com.sabah.bikhushue.BeadsCircleView
        android:id="@+id/beadsCircle"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="32dp" />

    <TextView
        android:id="@+id/tvMainCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="33"
        android:textSize="96sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#3D2B1F"
        android:includeFontPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="@id/beadsCircle"
        app:layout_constraintBottom_toBottomOf="@id/beadsCircle"
        app:layout_constraintLeft_toLeftOf="@id/beadsCircle"
        app:layout_constraintRight_toRightOf="@id/beadsCircle" />

    <!-- Right Side Content (Zikr, Goals, Settings) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/beadsCircle">

        <!-- Zikr Pill Container -->
        <LinearLayout
            android:id="@+id/llZikrContainer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp">
            
            <TextView
                android:id="@+id/tvPrevZikr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟨"
                android:textSize="24sp"
                android:textColor="#C4A47C"
                android:layout_marginEnd="8dp"
                android:includeFontPadding="false"
                android:paddingBottom="2dp" />
                
            <TextSwitcher
                android:id="@+id/tsZikrWheel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
                
            <TextView
                android:id="@+id/tvNextZikr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟩"
                android:textSize="24sp"
                android:textColor="#C4A47C"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- Goals Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvGoal33"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_hollow_circle"
                android:text="33"
                android:textColor="#3D2B1F"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_margin="8dp" />

            <TextView
                android:id="@+id/tvGoal10"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_hollow_circle"
                android:text="10"
                android:textColor="#3D2B1F"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_margin="8dp" />

            <TextView
                android:id="@+id/tvGoal100"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_hollow_circle"
                android:text="100"
                android:textColor="#3D2B1F"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_margin="8dp" />

            <TextView
                android:id="@+id/tvGoal1000"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_hollow_circle"
                android:text="1k"
                android:textColor="#3D2B1F"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_margin="8dp" />
        </LinearLayout>

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <ImageView
                android:id="@+id/tvAddZikr"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add"
                android:padding="8dp"
                android:layout_marginHorizontal="24dp" />

            <ImageView
                android:id="@+id/tvResetCounter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refresh_widget"
                android:padding="8dp"
                android:layout_marginHorizontal="24dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
