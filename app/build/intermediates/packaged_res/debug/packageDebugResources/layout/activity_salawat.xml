<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tasbeehRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Salawat Title Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llZikrContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSalawatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="صل على النبي\nإِذاً تُكْفَى هَمَّكَ، ويُغْفَرَ لَكَ ذَنْبُكَ"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- The Frame Wrapper -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/llZikrContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Main Shadow Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tasbeehMainShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#2E7D32"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tasbeehMainCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#2E7D32">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tasbeehFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_decorative_frame"
                android:clickable="true"
                android:focusable="true">

        <!-- Goal 100 (Top Start Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal100"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="100"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-10dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Goal 500 (Top End Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal500"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="500"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-10dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <!-- Goal 1000 (Bottom Start Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal1000"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="1k"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-6dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Goal 5000 (Bottom End Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal5000"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="5k"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-6dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Beads Circle -->
        <com.sabah.bikhushue.BeadsCircleView
            android:id="@+id/beadsCircle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvGoal100"
            app:layout_constraintBottom_toTopOf="@id/tvGoal1000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Giant Counter -->
        <TextView
            android:id="@+id/tvMainCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="1000"
            android:textSize="80sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1B5E20"
            android:includeFontPadding="false"
            android:translationY="-16dp"
            app:layout_constraintTop_toTopOf="@id/beadsCircle"
            app:layout_constraintBottom_toBottomOf="@id/beadsCircle"
            app:layout_constraintStart_toStartOf="@id/beadsCircle"
            app:layout_constraintEnd_toEndOf="@id/beadsCircle" />

        <ImageView
            android:id="@+id/tvResetCounter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_refresh_widget"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvGoal100"
            app:layout_constraintEnd_toStartOf="@id/tvGoal500" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <include layout="@layout/layout_bottom_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
