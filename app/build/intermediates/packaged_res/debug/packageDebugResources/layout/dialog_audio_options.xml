<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Handle line for bottom sheet -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="#D2B48C"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvAudioSurahTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="خيارات الاستماع للسورة"
        android:textColor="#3D2B1F"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تتطلب هذه السورة اتصالاً بالإنترنت"
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اختر القارئ:"
            android:textColor="#5D4037"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgReciters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbAlafasy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مشاري العفاسي"
                android:textColor="#3D2B1F"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbAbdulBasit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عبدالباسط عبدالصمد"
                android:textColor="#3D2B1F"/>
        </RadioGroup>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadSurah"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="تحميل السورة"
                    app:icon="@android:drawable/stat_sys_download"
                    app:iconGravity="textStart"
                    app:backgroundTint="#F4ECD8"
                    android:textColor="#3D2B1F"
                    app:strokeWidth="1dp"
                    app:strokeColor="#D2B48C"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <ProgressBar
                    android:id="@+id/pbDownload"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:max="100" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlaySurah"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="تشغيل"
                    app:icon="@android:drawable/ic_media_play"
                    app:iconGravity="textStart"
                    app:backgroundTint="#00A86B"
                    android:textColor="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
