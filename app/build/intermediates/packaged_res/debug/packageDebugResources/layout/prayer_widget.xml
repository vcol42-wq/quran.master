<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_prayer">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/iv_widget_bg_mosque"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="1.0" />

    <!-- Dark Overlay for text contrast -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <!-- Main Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ======================= -->
        <!-- LEVEL 3: TOP ROW (INFO) -->
        <!-- ======================= -->
        <RelativeLayout
            android:id="@+id/layout_widget_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <!-- Next Prayer (Top Left) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_next_prayer_title_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصلاة القادمة"
                    android:textColor="#FEF3C7"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_next_prayer_name_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Clock & City (Top Center) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:paddingStart="80dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/widget_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_widget_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الموقع"
                    android:textColor="#FEF3C7"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Sunrise (Top Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="28sp" />
                <TextView
                    android:id="@+id/tv_sunrise_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Spacer containing the App Icon centered and moved down slightly (under center) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:src="@drawable/nnbb"
                android:alpha="0.8" />
        </FrameLayout>

        <!-- ======================= -->
        <!-- LEVEL 1: PRAYERS -->
        <!-- ======================= -->
        <LinearLayout
            android:id="@+id/layout_prayers_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#66000000"
            android:padding="6dp"
            android:weightSum="5">

            <!-- Fajr -->
            <LinearLayout
                android:id="@+id/layout_fajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_fajr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="فجر"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_fajr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dhuhr -->
            <LinearLayout
                android:id="@+id/layout_dhuhr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_dhuhr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ظهر"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_dhuhr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Asr -->
            <LinearLayout
                android:id="@+id/layout_asr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_asr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عصر"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_asr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:id="@+id/layout_maghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_maghrib_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مغرب"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_maghrib_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Isha -->
            <LinearLayout
                android:id="@+id/layout_isha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_isha_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عشاء"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_isha_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======================= -->
        <!-- LEVEL 2: TASBEEH -->
        <!-- ======================= -->
        <RelativeLayout
            android:id="@+id/layout_widget_salawat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <!-- Reset Icon (Left side) -->
            <ImageView
                android:id="@+id/iv_widget_reset"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:padding="6dp"
                android:src="@drawable/ic_refresh_widget"
                android:alpha="0.9" />

            <!-- Salawat Phrase (Center) -->
            <TextView
                android:id="@+id/tv_motivational_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="صَلِّ عَلَى النَّبِيِّ"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Counter (Right side) -->
            <TextView
                android:id="@+id/tv_widget_salawat_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingEnd="16dp"
                android:text="0"
                android:textColor="#FEF3C7"
                android:textSize="26sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Decorative Border over the whole widget -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_decorative_frame"
        android:scaleType="fitXY" />

    <!-- Center transparent area for opening app via double tap -->
    <FrameLayout
        android:id="@+id/view_center_open_app"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent" />

</FrameLayout>
