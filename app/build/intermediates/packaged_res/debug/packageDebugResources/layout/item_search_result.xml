<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FAF3E0"
    app:strokeWidth="1dp"
    app:strokeColor="#E6DCC8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSearchSuraInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8B4513"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSearchVerseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiri_quran"
            android:textColor="#3D2B1F"
            android:textSize="20sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفسير الجلالين:"
            android:textColor="#8B4513"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvSearchTafseer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#5D4037"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchGemini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="استزادة جُمني"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_info_details"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchPlayAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="استماع"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_media_play"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
