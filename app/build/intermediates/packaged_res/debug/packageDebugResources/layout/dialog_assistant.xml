<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp">

    <!-- Handle line for bottom sheet -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="#D2B48C"
        app:cardCornerRadius="3dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="المساعد الذكي (جُمني)"
        android:textColor="#3D2B1F"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:id="@+id/svAssistant"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvAssistantResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مرحباً! أنا مساعدك الذكي. يمكنك سؤالي عن تفسير آية، البحث في الأذكار، أو المساعدة في تغيير الثيم (مثلاً: أريد الثيم الليلي، أو السماوي)."
            android:textColor="#3D2B1F"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="16dp"/>
    </ScrollView>

    <ProgressBar
        android:id="@+id/pbAssistantLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- Shadow Wrapper for Assistant Input -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <!-- Shadow Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#D2B48C"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#FAF3E0"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#00A86B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/etAssistantInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="تغيير الثيم أو ابحث هنا..."
                    android:background="@null"
                    android:textColor="#3D2B1F"
                    android:textColorHint="#9E9E9E"
                    android:textSize="16sp"
                    android:layout_marginEnd="12dp"/>

                <ImageView
                    android:id="@+id/btnAssistantSend"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#8B4513"
                    android:padding="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
