<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4ECD8">

<ScrollView
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4ECD8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header Card: Countdown & Location -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shadowNextPrayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#D2B48C"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextPrayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1B4332"
                app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/bg_decorative_frame">

                <TextView
                    android:id="@+id/tvNextPrayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="متبقي لصلاة العصر"
                    android:textColor="#A3E4D7"
                    android:textSize="18sp"
                    android:fontFamily="@font/amiri_quran"
                    android:textStyle="bold" />

                <!-- Countdown Text: Big & Clear -->
                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03:03:33"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-thin"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp" />

                <!-- Date Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_date_chip"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tvGregorianDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16 يوليو 2026"
                        android:textColor="#FDF5E6"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:alpha="0.85" />

                    <TextView
                        android:id="@+id/tvHijriDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 محرم 1448"
                        android:textColor="#D4AF37"
                        android:textSize="18sp"
                        android:fontFamily="@font/amiri_quran"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Region / Timezone -->
                <TextView
                    android:id="@+id/tvRegion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asia/Riyadh"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:alpha="0.8" />

                <!-- City Name -->
                <TextView
                    android:id="@+id/tvCityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الرياض"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/amiri_quran" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Prayer Times Grid/Table Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTimesTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#00000000"
                app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_decorative_frame">

                <!-- Fajr -->
                <LinearLayout
                    android:id="@+id/layoutFajr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_pill">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الفجر"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="4dp" android:paddingHorizontal="2dp" android:paddingVertical="2dp" >
                        <TextView android:id="@+id/btnDecFAJR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                        <TextView android:id="@+id/tvOffsetFAJR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textColor="#8B7355" android:minWidth="16dp" android:gravity="center" android:textStyle="bold" />
                        <TextView android:id="@+id/btnIncFAJR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTimeFajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:30 ص"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B4332" />
                </LinearLayout>

                <!-- Sunrise -->
                <LinearLayout
                    android:id="@+id/layoutSunrise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_pill">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الشروق"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="4dp" android:paddingHorizontal="2dp" android:paddingVertical="2dp" >
                        <TextView android:id="@+id/btnDecSUNRISE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                        <TextView android:id="@+id/tvOffsetSUNRISE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textColor="#8B7355" android:minWidth="16dp" android:gravity="center" android:textStyle="bold" />
                        <TextView android:id="@+id/btnIncSUNRISE" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTimeSunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:50 ص"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B4332" />
                </LinearLayout>

                <!-- Dhuhr -->
                <LinearLayout
                    android:id="@+id/layoutDhuhr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_pill">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الظهر"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="4dp" android:paddingHorizontal="2dp" android:paddingVertical="2dp" >
                        <TextView android:id="@+id/btnDecDHUHR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                        <TextView android:id="@+id/tvOffsetDHUHR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textColor="#8B7355" android:minWidth="16dp" android:gravity="center" android:textStyle="bold" />
                        <TextView android:id="@+id/btnIncDHUHR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTimeDhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:05 م"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B4332" />
                </LinearLayout>

                <!-- Asr -->
                <LinearLayout
                    android:id="@+id/layoutAsr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_pill">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="العصر"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="4dp" android:paddingHorizontal="2dp" android:paddingVertical="2dp" >
                        <TextView android:id="@+id/btnDecASR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                        <TextView android:id="@+id/tvOffsetASR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textColor="#8B7355" android:minWidth="16dp" android:gravity="center" android:textStyle="bold" />
                        <TextView android:id="@+id/btnIncASR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTimeAsr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="03:30 م"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B4332" />
                </LinearLayout>

                <!-- Maghrib -->
                <LinearLayout
                    android:id="@+id/layoutMaghrib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_pill">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المغرب"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="4dp" android:paddingHorizontal="2dp" android:paddingVertical="2dp" >
                        <TextView android:id="@+id/btnDecMAGHRIB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                        <TextView android:id="@+id/tvOffsetMAGHRIB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textColor="#8B7355" android:minWidth="16dp" android:gravity="center" android:textStyle="bold" />
                        <TextView android:id="@+id/btnIncMAGHRIB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTimeMaghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06:20 م"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B4332" />
                </LinearLayout>

                <!-- Isha -->
                <LinearLayout
                    android:id="@+id/layoutIsha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_pill">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="العشاء"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="4dp" android:paddingHorizontal="2dp" android:paddingVertical="2dp" >
                        <TextView android:id="@+id/btnDecISHA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                        <TextView android:id="@+id/tvOffsetISHA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textColor="#8B7355" android:minWidth="16dp" android:gravity="center" android:textStyle="bold" />
                        <TextView android:id="@+id/btnIncISHA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="16sp" android:padding="4dp" android:textStyle="bold" android:textColor="#8B7355" android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTimeIsha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:50 م"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B4332" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Sound / Audio Settings Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shadowAudioToggle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#D2B48C"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAudioToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#00A86B"
                app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_decorative_frame">

                <TextView
                    android:id="@+id/tvSoundStatusIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvSoundStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="صوت الأذان مفعل"
                    android:textSize="16sp"
                    android:textColor="#3D2B1F"
                    android:fontFamily="@font/amiri_quran" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Expandable General Settings Card (Dropdown) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shadowGeneralSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#D2B48C"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGeneralSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#00A86B"
                app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_decorative_frame">

                <!-- Header of settings (Toggle dropdown) -->
                <LinearLayout
                    android:id="@+id/layoutSettingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="22sp"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="الضبط العام للمواقيت والموقع"
                        android:textSize="16sp"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDropdownIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="14sp"
                        android:textColor="#8B7355" />
                </LinearLayout>

                <!-- Hidden/Expandable Settings Body -->
                <LinearLayout
                    android:id="@+id/layoutSettingsBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F2F2F2"
                        android:layout_marginBottom="16dp" />

                    <!-- Quick Location Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- Auto Location Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAutoLocation"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="تحديد تلقائي 🧭"
                            android:textColor="#1B4332"
                            app:strokeColor="#1B4332"
                            app:cornerRadius="8dp" />

                        <!-- Manual Location Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualLocation"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="إدخال يدوي ✍️"
                            android:textColor="#1B4332"
                            app:strokeColor="#1B4332"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <!-- Coordinates Display -->
                    <TextView
                        android:id="@+id/tvCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الإحداثيات: 24.7136, 46.6753"
                        android:textSize="12sp"
                        android:textColor="#8B7355"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- Calculation Method Dropdown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="طريقة حساب أوقات الصلاة:"
                        android:textSize="14sp"
                        android:textColor="#3D2B1F"
                        android:fontFamily="@font/amiri_quran"
                        android:layout_marginBottom="6dp" />

                    <!-- Shadow Wrapper for Spinner -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/shadowCalcMethod"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="4dp"
                            app:cardBackgroundColor="#D2B48C"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="#00A86B">
                            
                            <Spinner
                                android:id="@+id/spinnerCalcMethod"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:background="@android:drawable/btn_dropdown"/>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <!-- Sound/Ringtone Chooser Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChooseSound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="اختر صوت الأذان من الهاتف 🎵"
                        android:backgroundTint="#1B4332"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="8dp" />

                    <TextView
                        android:id="@+id/tvSelectedSoundPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الصوت المحدد: الافتراضي"
                        android:textSize="12sp"
                        android:textColor="#8B7355"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />
                        
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="للتواصل والمقترحات:\nvcol42@gmail.com"
                        android:textSize="12sp"
                        android:textColor="#3D2B1F"
                        android:gravity="center"
                        android:textIsSelectable="true"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

    </LinearLayout>
</ScrollView>

<include layout="@layout/layout_bottom_bar" />

</RelativeLayout>
