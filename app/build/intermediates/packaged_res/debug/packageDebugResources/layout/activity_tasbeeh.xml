<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tasbeehRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Zikr Pill Container Wrapper -->
    <FrameLayout
        android:id="@+id/flZikrWrapper"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Shadow Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZikrShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#D2B48C"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZikrInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/llZikrContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@drawable/bg_decorative_frame"
                android:paddingHorizontal="16dp"
                android:gravity="center">
                
                <ImageView
                    android:id="@+id/tvPrevZikr"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_left"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="4dp"
                    android:translationY="-4dp" />
                    
                <TextSwitcher
                    android:id="@+id/tsZikrWheel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                    
                <ImageView
                    android:id="@+id/tvNextZikr"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_right"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="4dp"
                    android:translationY="-4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- The Frame Wrapper -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintTop_toBottomOf="@id/flZikrWrapper"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Main Shadow Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tasbeehMainShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#D2B48C"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tasbeehMainCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#D2B48C">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tasbeehFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_decorative_frame"
                android:clickable="true"
                android:focusable="true">

        <!-- Goal 33 (Top Start Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal33"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="33"
            android:textColor="#3D2B1F"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-10dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Goal 10 (Top End Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal10"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="10"
            android:textColor="#3D2B1F"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-10dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <!-- Goal 100 (Bottom Start Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal100"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="100"
            android:textColor="#3D2B1F"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-6dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Goal 1000 (Bottom End Screw) -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="12dp"
            android:src="@drawable/mn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <TextView
            android:id="@+id/tvGoal1000"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="1k"
            android:textColor="#3D2B1F"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:translationY="-6dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Beads Circle -->
        <com.sabah.bikhushue.BeadsCircleView
            android:id="@+id/beadsCircle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvGoal33"
            app:layout_constraintBottom_toTopOf="@id/tvGoal100"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Giant Counter -->
        <TextView
            android:id="@+id/tvMainCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="33"
            android:textSize="96sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#3D2B1F"
            android:includeFontPadding="false"
            android:translationY="-16dp"
            app:layout_constraintTop_toTopOf="@id/beadsCircle"
            app:layout_constraintBottom_toBottomOf="@id/beadsCircle"
            app:layout_constraintStart_toStartOf="@id/beadsCircle"
            app:layout_constraintEnd_toEndOf="@id/beadsCircle" />

        <ImageView
            android:id="@+id/tvResetCounter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_refresh_widget"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvGoal33"
            app:layout_constraintEnd_toStartOf="@id/tvGoal10" />

        <ImageView
            android:id="@+id/tvAddZikr"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_add"
            android:padding="8dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvGoal100"
            app:layout_constraintEnd_toStartOf="@id/tvGoal1000" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <include layout="@layout/layout_bottom_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
