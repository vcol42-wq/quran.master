<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <!-- Shadow Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="#D2B48C"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- Main Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAzkarRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#00A86B"
        app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvAzkarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="سيد الاستغفار"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3D2B1F"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAzkarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="اللَّهُمَّ أَنْتَ رَبِّي لا إِلَهَ إِلا أَنْتَ..."
            android:fontFamily="@font/amiri_quran"
            android:textSize="24sp"
            android:textColor="#3D2B1F"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAzkarVirtue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="من قاله موقناً به ومات دخل الجنة"
            android:textSize="14sp"
            android:textColor="#00A86B"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <FrameLayout
            android:id="@+id/flCountContainer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_count">

            <TextView
                android:id="@+id/tvAzkarCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:text="100"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#3D2B1F" />
                
            <TextView
                android:id="@+id/tvAzkarDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="تم"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#3D2B1F"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</FrameLayout>
