<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/itemNumber"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/hizb_badge"
            android:gravity="center"
            android:text="1"
            android:textColor="#8B4513"
            android:textSize="16sp"
            android:fontFamily="@font/amiri_quran"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/itemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/itemNumber"
            android:layout_marginStart="20dp"
            android:layout_centerVertical="true"
            android:text="سورة الفاتحة"
            android:textColor="#3D2B1F"
            android:fontFamily="@font/amiri_quran"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/itemSubInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="صفحة 1"
            android:textColor="#B38F4D"
            android:fontFamily="@font/amiri_quran"
            android:textSize="14sp"/>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E6DCC8"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="16dp"/>

</LinearLayout>
