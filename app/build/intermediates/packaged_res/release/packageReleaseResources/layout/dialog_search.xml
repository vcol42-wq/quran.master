<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Shadow Wrapper for Search Input -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <!-- Shadow Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#D2B48C"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#00A86B">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ابحث عن كلمة أو آية..."
                android:fontFamily="@font/amiri_quran"
                android:padding="12dp"
                android:background="@null" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="خيارات سريعة:"
        android:textColor="#8B4513"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">
        <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5" android:layout_margin="2dp"/>
        <Button android:id="@+id/btn10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10" android:layout_margin="2dp"/>
        <Button android:id="@+id/btn15" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="15" android:layout_margin="2dp"/>
        <Button android:id="@+id/btn20" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="20" android:layout_margin="2dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnStartSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بدء البحث"
        android:backgroundTint="#8B4513"
        android:textColor="#FFFFFF"/>

</LinearLayout>
