<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground">

        <!-- رأس السورة -->
        <LinearLayout
            android:id="@+id/suraHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/basmalahCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D2B48C"
                app:cardBackgroundColor="#FAF3E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:id="@+id/suraTypeAndAyahsText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:fontFamily="@font/amiri_quran"
                        android:textSize="14sp"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeStepGranularity="1sp"
                        android:textColor="#3D2B1F"/>
                        
                    <TextView
                        android:id="@+id/suraNameAndNumberText"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:fontFamily="@font/amiri_quran"
                        android:textSize="18sp"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="18sp"
                        app:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/basmalahText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/amiri_quran"
                android:textSize="26sp"
                android:textColor="#3D2B1F"
                android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"/>
        </LinearLayout>

        <!-- النص القرآني المرصوص والمحاذى -->
        <TextView
            android:id="@+id/quranVerseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="26sp"
            android:lineSpacingMultiplier="1.0"
            android:includeFontPadding="false"
            android:fontFamily="@font/amiri_quran"
            android:textColor="#000000"
            android:justificationMode="inter_word"
            android:textIsSelectable="false"
            android:bufferType="spannable"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:shadowColor="@android:color/transparent"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="0"/>

        <!-- رقم الصفحة في الأسفل (وحده بدون خطوط) -->
        <TextView
            android:id="@+id/sectionTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="0dp"
            android:textSize="10sp"
            android:textColor="#9E9E9E"
            android:fontFamily="@font/amiri_quran"
            android:includeFontPadding="false"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
