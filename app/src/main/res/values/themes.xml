<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuranMaster" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#8B4513</item>
        <item name="colorPrimaryDark">#3D2B1F</item>
        <item name="colorAccent">#B38F4D</item>
        <item name="colorSurface">#FFF8E1</item>
        <item name="colorOnSurface">#3D2B1F</item>
        <item name="android:colorBackground">#F4ECD8</item>
        <item name="android:statusBarColor">#E6DCC8</item>
        <item name="android:navigationBarColor">#E6DCC8</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="fontFamily">@font/amiri_quran</item>
        <item name="android:fontFamily">@font/amiri_quran</item>
    </style>

    <!-- Splash Theme to avoid white flash and use animated background -->
    <style name="Theme.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">#050510</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>