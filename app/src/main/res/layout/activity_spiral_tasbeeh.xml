<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tasbeehRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Zikr Pill Container Wrapper -->
    <FrameLayout
        android:id="@+id/flZikrWrapper"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZikrShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#D2B48C"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZikrInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/llZikrContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@drawable/bg_decorative_frame"
                android:paddingHorizontal="16dp"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tvSalawatStatic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صل على النبي"
                    android:textColor="#8B7355"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Tasbeeh Frame Wrapper -->
    <FrameLayout
        android:id="@+id/flMainCardWrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/flZikrWrapper"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Main Shadow Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tasbeehMainShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#D2B48C"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tasbeehMainCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#D2B48C">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tasbeehFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_decorative_frame"
                android:clickable="true"
                android:focusable="true">

                <!-- Beads Rectangular Border -->
                <com.sabah.bikhushue.SpiralBeadsView
                    android:id="@+id/beadsCircle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp" />

                <!-- Giant Counter (The Anchor) -->
                <TextView
                    android:id="@+id/tvMainCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="100"
                    android:textSize="80sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#3D2B1F"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.45" />

                <!-- Salawat Quote (Directly above Counter) -->
                <TextView
                    android:id="@+id/tvSalawatQuote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:text="إذا صليت على النبي يُكفى همك ويُغفر ذنبك"
                    android:textColor="#A08C73"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:translationY="48dp"
                    app:layout_constraintBottom_toTopOf="@id/tvMainCounter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Hundreds Counter (Directly below Counter) -->
                <TextView
                    android:id="@+id/tvHundredsCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="الدورات: 0"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#8B7355"
                    app:layout_constraintTop_toBottomOf="@id/tvMainCounter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/tvResetCounter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_refresh_widget"
                    android:padding="8dp"
                    android:layout_marginBottom="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <include 
        android:id="@+id/bottomBarLayout"
        layout="@layout/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
