<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground">

        <!-- فاصل علوي (إذا كان الحزب/الركوع في بداية السورة قبل البسملة) -->
        <FrameLayout
            android:id="@+id/topSeparatorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- رأس السورة -->
        <LinearLayout
            android:id="@+id/suraHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/basmalahCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="2dp"
                app:strokeColor="#D2B48C"
                app:cardBackgroundColor="#FAF3E0">

                <LinearLayout
                    android:id="@+id/suraHeaderInnerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_sura_header_frame">
                    
                    <TextView
                        android:id="@+id/suraTypeAndAyahsText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:fontFamily="@font/amiri_quran"
                        android:textSize="11sp"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        android:textColor="#3D2B1F"/>
                        
                    <TextView
                        android:id="@+id/suraNameAndNumberText"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:fontFamily="@font/amiri_quran"
                        android:textSize="18sp"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="18sp"
                        app:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:textColor="#3D2B1F"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/basmalahText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/amiri_quran"
                android:textSize="26sp"
                android:textColor="#3D2B1F"
                android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"/>
        </LinearLayout>

        <!-- حاوية الآيات والفواصل -->
        <LinearLayout
            android:id="@+id/versesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- النص القرآني المرصوص والمحاذى -->
            <TextView
                android:id="@+id/quranVerseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="26sp"
                android:lineSpacingMultiplier="1.0"
                android:includeFontPadding="false"
                android:fontFamily="@font/amiri_quran"
                android:textColor="#000000"
                android:justificationMode="inter_word"
                android:textIsSelectable="false"
                android:bufferType="spannable"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:shadowColor="@android:color/transparent"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="0"/>
        </LinearLayout>

        <!-- رقم الصفحة والمؤشرات الجانبية (محاذاة مطلقة لليمن واليسار) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp">

            <!-- جهة يسار المستخدم (دائرة حمراء للصفحات الزوجية) -->
            <View
                android:id="@+id/indicatorLeft"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_indicator_red_soft"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/sectionTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/amiri_quran"
                android:includeFontPadding="false"
                android:text="ص 1" />

            <!-- جهة يمين المستخدم (دائرة خضراء للصفحات الفردية) -->
            <View
                android:id="@+id/indicatorRight"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_indicator_green_soft"
                android:visibility="invisible" />
        </RelativeLayout>

        <!-- بطاقة دعاء ختم القرآن الكريم -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/khatmQuranCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeWidth="2dp"
            app:strokeColor="#D2B48C"
            app:cardBackgroundColor="#FAF3E0">

            <LinearLayout
                android:id="@+id/khatmInnerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center"
                android:background="@drawable/bg_sura_header_frame">

                <TextView
                    android:id="@+id/khatmTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/amiri_quran"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:text="۞ دُعَاءُ خَتْمِ الْقُرْآنِ الْكَرِيمِ ۞"/>

                <View
                    android:id="@+id/khatmDivider"
                    android:layout_width="140dp"
                    android:layout_height="2dp"
                    android:layout_marginVertical="10dp"
                    android:background="#D2B48C"/>

                <TextView
                    android:id="@+id/khatmBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/amiri_quran"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="#3D2B1F"
                    android:text="اللَّهُمَّ ارْحَمْنِي بِالْقُرْآنِ، وَاجْعَلْهُ لِي إِمَامًا وَنُورًا وَهُدًى وَرَحْمَةً.\n\nاللَّهُمَّ ذَكِّرْنِي مِنْهُ مَا نَسِيتُ، وَعَلِّمْنِي مِنْهُ مَا جَهِلْتُ، وَارْزُقْنِي تِلاَوَتَهُ آنَاءَ اللَّيْلِ وَأَطْرَافَ النَّهَارِ، وَاجْعَلْهُ لِي حُجَّةً يَا رَبَّ الْعَالَمِينَ.\n\nاللَّهُمَّ أَصْلِحْ لِي دِينِي الَّذِي هُوَ عِصْمَةُ أَمْرِي، وَأَصْلِحْ لِي دُنْيَايَ الَّتِي فِيهَا مَعَاشِي، وَأَصْلِحْ لِي آخِرَتِي الَّتِي فِيهَا مَعَادِي، وَاجْعَلِ الْحَيَاةَ زِيَادَةً لِي فِي كُلِّ خَيْرٍ، وَاجْعَلِ الْمَوْتَ رَاحَةً لِي مِنْ كُلِّ شَرٍّ.\n\nاللَّهُمَّ اجْعَلْ خَيْرَ عُمْرِي آخِرَهُ، وَخَيْرَ عَمَلِي خَوَاتِمَهُ، وَخَيْرَ أَيَّامِي يَوْمَ أَلْقَاكَ فِيهِ.\n\nاللَّهُمَّ إِنِّي أَسْأَلُكَ عِيشَةً هَنِيَّةً، وَمِيتَةً سَوِيَّةً، وَمَرَدًّا غَيْرَ مُخْزٍ وَلاَ فَاضِحٍ.\n\nاللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَ الْمَسْأَلَةِ، وَخَيْرَ الدُّعَاءِ، وَخَيْرَ النَّجَاحِ، وَخَيْرَ الْعِلْمِ، وَخَيْرَ الْعَمَلِ، وَخَيْرَ الثَّوَابِ، وَخَيْرَ الْحَيَاةِ، وَخَيْرَ الْمَمَاتِ، وَثَبِّتْنِي وَثَقِّلْ مَوَازِينِي، وَحَقِّقْ إِيمَانِي، وَارْفَعْ دَرَجَتِي، وَتَقَبَّلْ صَلاَتِي، وَاغْفِرْ خَطِيئَاتِي، وَأَسْأَلُكَ الدَّرَجَاتِ الْعُلاَ مِنَ الْجَنَّةِ.\n\nاللَّهُمَّ أَحْسِنْ عَاقِبَتَنَا فِي الأُمُورِ كُلِّهَا، وَأَجِرْنَا مِنْ خِزْيِ الدُّنْيَا وَعَذَابِ الآخِرَةِ.\n\nوَصَلَّى اللَّهُ عَلَى سَيِّدِنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا كَثِيرًا."/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
