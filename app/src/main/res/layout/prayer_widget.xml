<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_prayer">

    <!-- خلفية الودجت تتغير برمجيا (osc او pop) -->
    <ImageView
        android:id="@+id/iv_widget_bg_mosque"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/osc"
        android:scaleType="centerCrop"
        android:alpha="0.85" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- الجزء العلوي: الساعة والموقع في الوسط تماما -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:shadowColor="#B3000000"
                android:shadowRadius="6"
                android:shadowDx="0"
                android:shadowDy="2" />

            <TextView
                android:id="@+id/tv_widget_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الموقع"
                android:textColor="#FEF3C7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:shadowColor="#B3000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="1" />
        </LinearLayout>

        <!-- الجزء الأوسط: مساحة فارغة لإظهار الصورة -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- الجزء السفلي: العداد، باقي للصلاة، وأوقات الصلاة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#99000000"
            android:padding="10dp"
            android:layout_marginBottom="2dp">

            <!-- عداد الصلاة على النبي (Salawat) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_motivational_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صَلِّ عَلَى النَّبِيِّ"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_widget_salawat_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FEF3C7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <!-- زر التصفير (Reset) -->
                <ImageView
                    android:id="@+id/iv_widget_reset"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_refresh_widget"
                    android:alpha="0.8"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- باقي للصلاة -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_next_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="باقي للصلاة"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="00:00"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- شريط أوقات الصلاة (بدون شروق) -->
            <LinearLayout
                android:id="@+id/layout_prayers_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="5">

                <!-- الفجر -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_fajr_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فجر"
                        android:textColor="#FEF3C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_fajr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- الظهر -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_dhuhr_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ظهر"
                        android:textColor="#FEF3C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_dhuhr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- العصر -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_asr_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عصر"
                        android:textColor="#FEF3C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_asr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- المغرب -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_maghrib_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مغرب"
                        android:textColor="#FEF3C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_maghrib_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- العشاء -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_isha_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عشاء"
                        android:textColor="#FEF3C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_isha_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
