<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_prayer">

    <!-- خلفية اللؤلؤ والهلال الملكية -->
    <ImageView
        android:id="@+id/iv_widget_bg_mosque"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/osc"
        android:scaleType="centerCrop"
        android:alpha="0.70" />

    <!-- صورة جانبية إضافية (على اليمين) -->
    <ImageView
        android:id="@+id/iv_widget_side_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:src="@drawable/nnbb"
        android:alpha="0.9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- الطبقة العلوية: المعلومات الذكية -->
        <RelativeLayout
            android:id="@+id/layout_expanded_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_next_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="باقي لصلاة"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="00:00"
                    android:textColor="#FEF3C7"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sunrise_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الشروق: 00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_sunrise"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- الطبقة الوسطى: الساعة والعداد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="start"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- زر التصفير -->
                        <ImageView
                            android:id="@+id/iv_widget_reset"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_refresh_widget"
                            android:layout_marginEnd="8dp"
                            android:alpha="0.8"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- عداد التسبيح من جهة (اليسار/البداية) -->
                        <TextView
                            android:id="@+id/tv_widget_salawat_counter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FEF3C7"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- رسالة التحفيز -->
                    <TextView
                        android:id="@+id/tv_motivational_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سَبِّحْ بِخُشُوع"
                        android:textColor="#E0E0E0"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:textStyle="italic" />
                </LinearLayout>

                <!-- مجموعة الساعة والمدينة من جهة اليمين (النهاية) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/widget_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_widget_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الرياض"
                        android:textColor="#FEF3C7"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- طبقة المواقيت -->
        <LinearLayout
            android:id="@+id/layout_prayers_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="5"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fajr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="فجر"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_fajr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dhuhr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ظهر"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dhuhr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_asr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عصر"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_asr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_maghrib_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مغرب"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_maghrib_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_isha_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عشاء"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_isha_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- الجزء السفلي للتسبيح -->
        <RelativeLayout
            android:id="@+id/btn_widget_salawat_clicker"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:backgroundTint="#80004000"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="صَلِّ عَلَى النَّبِيِّ ﷺ"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

    <!-- الجوانب الشفافة لإكمال شكل حرف U (لالتسبيح) -->
    <ImageView
        android:id="@+id/btn_widget_side_left"
        android:layout_width="54dp"
        android:layout_height="140dp"
        android:layout_gravity="bottom|start"
        android:src="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/btn_widget_side_right"
        android:layout_width="54dp"
        android:layout_height="140dp"
        android:layout_gravity="bottom|end"
        android:src="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
