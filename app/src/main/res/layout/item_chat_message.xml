<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llMessageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <!-- Shadow Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMessageShadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="#D2B48C"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- Main Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMessageInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#00A86B"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_decorative_frame">

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3D2B1F"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
