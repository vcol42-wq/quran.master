<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F4ECD8">

    <ScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- زر الانتقال للواجهة التفاعلية -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSwitchToExpHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#C5A059"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الواجهة التفاعلية ⚡"
                    android:textColor="#2E5B42"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/kitab_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. كارت المتابعة والتدفق الروحي (Dynamic Flow Header Card) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp">

            <!-- Shadow Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#202E5B42"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <!-- Main Dynamic Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDynamicHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#2E5B42"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="18dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_decorative_frame"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_mushaf"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDynamicHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تابع وردك اليومي"
                            android:textColor="#2E5B42"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/kitab_regular" />

                        <TextView
                            android:id="@+id/tvDynamicHeaderSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="سورة البقرة • صفحة 1 (انقر للمتابعة)"
                            android:textColor="#665343"
                            android:textSize="13sp"
                            android:fontFamily="@font/kitab_regular" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_left"
                        app:tint="#2E5B42" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- 2. كارت الصلاة على النبي (Salawat Banner) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp">

            <!-- Shadow Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#202E5B42"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <!-- Main Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSalawat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#C5A059"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_decorative_frame"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="صل على النبي ﷺ"
                        android:textColor="#3D2B1F"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:fontFamily="@font/kitab_regular" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- 3. شبكة المحاور الرئيسية الأربعة (4 Core Worship Cards Grid) -->
        <!-- الصف الأول: المصحف والأذكار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp">

            <!-- Card 1: تلاوة القرآن -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">
                
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="#152E5B42"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#2E5B42"
                    app:cardBackgroundColor="#FFFFFF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/bg_decorative_frame"
                        android:foreground="?attr/selectableItemBackground">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_mushaf"
                            android:layout_marginBottom="10dp" />
                            
                        <TextView
                            android:id="@+id/tvCardQuranTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تلاوة القرآن"
                            android:textColor="#3D2B1F"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="@font/kitab_regular" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Card 2: الأذكار والدعاء -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp">
                
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="#152E5B42"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAzkar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#2E5B42"
                    app:cardBackgroundColor="#FFFFFF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/bg_decorative_frame"
                        android:foreground="?attr/selectableItemBackground">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_mihrab"
                            android:layout_marginBottom="10dp" />
                            
                        <TextView
                            android:id="@+id/tvCardAzkarTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الأذكار والدعاء"
                            android:textColor="#3D2B1F"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="@font/kitab_regular" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </LinearLayout>

        <!-- الصف الثاني: سبح بخشوع ومواقيت الصلاة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="20dp">

            <!-- Card 3: سبح بخشوع -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="#152E5B42"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTasbeeh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#2E5B42"
                    app:cardBackgroundColor="#FFFFFF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/bg_decorative_frame"
                        android:foreground="?attr/selectableItemBackground">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_tasbeeh_beads"
                            android:layout_marginBottom="10dp" />
                            
                        <TextView
                            android:id="@+id/tvCardTasbeehTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="سبح بخشوع"
                            android:textColor="#3D2B1F"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="@font/kitab_regular" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Card 4: مواقيت الصلاة -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="#152E5B42"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPrayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#2E5B42"
                    app:cardBackgroundColor="#FFFFFF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/bg_decorative_frame"
                        android:foreground="?attr/selectableItemBackground">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_prayer_clock"
                            android:layout_marginBottom="10dp" />
                            
                        <TextView
                            android:id="@+id/tvCardPrayerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مواقيت الصلاة"
                            android:textColor="#3D2B1F"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/kitab_regular" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </LinearLayout>

        <!-- المساحة المرنة -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="30dp" />

        <!-- App Footer Title Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_decorative_frame"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvHomeFooterTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سبح بخشوع"
                        android:textColor="#3D2B1F"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:fontFamily="@font/kitab_regular" />

                    <TextView
                        android:id="@+id/tvHomeFooterSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="تطبيق التدبر والقراءة والأذكار اليومية"
                        android:textColor="#8B7355"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:fontFamily="@font/kitab_regular" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

    </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_bar" />

</RelativeLayout>
