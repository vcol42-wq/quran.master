<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft blur 3D shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#22000000" />
        </shape>
    </item>
    <!-- Middle dark shadow layer -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#42000000" />
        </shape>
    </item>
    <!-- Deep core 3D drop shadow layer under unified piece -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#68000000" />
        </shape>
    </item>
</layer-list>
