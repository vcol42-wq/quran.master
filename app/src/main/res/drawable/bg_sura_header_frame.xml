<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الإطار الخارجي الذهبي -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#D2B48C" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    
    <!-- خط ذهبي دقيق داخلي -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#8B7355" />
            <corners android:radius="11dp" />
        </shape>
    </item>

    <!-- النقاط والزخارف الإسلامية المحيطة بالإطار -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#1B5E20"
                    android:dashWidth="4dp" android:dashGap="4dp" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
