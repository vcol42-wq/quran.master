<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Real Spherical Round Beads Ring (خرزات دائرية مدورة 100%) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="14dp"
                android:color="#D4AF37"
                android:dashWidth="1dp"
                android:dashGap="16dp" />
        </shape>
    </item>

    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#2E5B42" />
        </shape>
    </item>
</layer-list>
