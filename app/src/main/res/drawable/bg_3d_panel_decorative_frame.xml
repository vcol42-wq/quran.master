<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Metallic Gold Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#FFD700" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    
    <!-- Inner Inset Gold Frame -->
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#C5A059" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Inner Emerald Decorative Beaded Border -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="rectangle">
            <stroke android:width="2.5dp" android:color="#2E5B42"
                    android:dashWidth="4dp" android:dashGap="5dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
